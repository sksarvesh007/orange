# ==============================================================================
# Errand Agent Environment Configuration
# ==============================================================================

# Application Environment (development | testing | production)
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
WORKERS=4

# Database Connection
# Local development default: SQLite
DATABASE_URL=sqlite+aiosqlite:///errand_agent.db
# Docker Compose / Production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/errand_agent

# Redis Task Queue
REDIS_URL=redis://localhost:6379/0

# Logging & Telemetry
LOG_LEVEL=INFO
LOG_JSON=false
ENABLE_METRICS=true
TRACE_DIR=artifacts/traces

# Langfuse Configuration (Optional exporter, off by default)
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-sample-public-key
LANGFUSE_SECRET_KEY=sk-lf-sample-secret-key
LANGFUSE_HOST=http://localhost:3000

# Optional Live LLM Adapter (Section 10; off by default, uses scripted model)
LLM_PROVIDER=mock
LLM_MODEL_NAME=gpt-4o-mini
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=5.0
